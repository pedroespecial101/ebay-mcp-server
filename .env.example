# Prefer Doppler for runtime injection, but a local dotenv file also works.

# Shared eBay app credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional: point the auth flow at a specific dotenv file.
# EBAY_CREDENTIALS_FILE=/absolute/path/to/.env

# Seller OAuth and login wiring.
EBAY_RU_NAME=
EBAY_APP_CONFIGURED_REDIRECT_URI=
EBAY_TOKEN_STORE=doppler
DOPPLER_PROJECT=ebay-mcp
DOPPLER_CONFIG=dev

# User-level auth state. Keep this separate from the browse MCP.
EBAY_USER_ACCESS_TOKEN=
EBAY_USER_REFRESH_TOKEN=
EBAY_USER_ID=
EBAY_USER_NAME=

# UK seller defaults.
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_LOCALE=en-GB
EBAY_CURRENCY=GBP
EBAY_DELIVERY_COUNTRY=GB
# EBAY_DELIVERY_POSTAL_CODE=SW1A1AA

# Optional Trading API overrides. If omitted, direct Trading listings resolve
# city/postcode from EBAY_MERCHANT_LOCATION_KEY through the Inventory API.
EBAY_ITEM_LOCATION=
EBAY_ITEM_POSTAL_CODE=
EBAY_TRADING_API_VERSION=1455

# Seller account policy/location IDs required when creating offers.
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=

# Runtime controls.
MCP_LOG_LEVEL=INFO
CLEAR_EBAY_USER_TOKENS=0
EBAY_ENABLE_INTERACTIVE_AUTH=1
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8766
# Private Cloudflare R2 listing-image staging
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ebay-listing-staging
EBAY_IMAGE_IMPORT_DIR=~/Pictures/eBay Listing Inbox
FASTMCP_CHECK_FOR_UPDATES=off
